        <i class="fa-solid fa-compass me-2 fs-4"></i> WanderLust
      </a>

      <!-- Search Button -->
      <button class="d-none d-lg-flex btn border rounded-pill shadow-sm px-3 py-2 d-flex align-items-center h-14"
