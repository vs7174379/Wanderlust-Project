        data-bs-toggle="modal" data-bs-target="#searchModal">

        <input type="text" class="form-control border-0 bg-transparent shadow-none flex-grow-1 ps-2"
          placeholder="Search destinations..." readonly />

        <span class="btn btn-danger rounded-circle d-flex align-items-center justify-content-center ms-2"
          style="width: 36px; height: 36px;">
