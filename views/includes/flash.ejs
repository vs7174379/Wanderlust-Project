<!-- Success Toast -->
<% if (success && success.length) { %>
  <div class="position-fixed top-24 end-0 p-3" style="z-index:2000;">
    <div class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-4 hide slide-in"
         role="alert"
         data-bs-autohide="true"
         data-bs-delay="4000">
      <div class="d-flex">
        <div class="toast-body">
          ✅ <%= success %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto"
                data-bs-dismiss="toast"
                aria-label="Close"></button>
      </div>
    </div>
  </div>
<% } %>

<!-- Error Toast -->
<% if (error && error.length) { %>
  <div class="position-fixed top-24 end-0 p-3" style="z-index:2000;">
    <div class="toast align-items-center text-white bg-danger border-0 shadow-lg rounded-4 hide slide-in"
         role="alert"
         data-bs-autohide="true"
         data-bs-delay="4000">
      <div class="d-flex">
        <div class="toast-body">
          ⚠️ <%= error %>
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto"
                data-bs-dismiss="toast"
                aria-label="Close"></button>
      </div>
    </div>
  </div>
<% } %>

<script>
document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll(".toast").forEach(function (el) {
    const toast = new bootstrap.Toast(el, {
      autohide: true,
      delay: 3000   // 4 seconds
    });
    toast.show();
  });
});
</script>

<style>
@keyframes slideInRight {
  from { transform: translateX(120%); opacity: 0; }
  to   { transform: translateX(0);    opacity: 1; }
}
.slide-in { animation: slideInRight 0.6s ease-out; }

</style>
