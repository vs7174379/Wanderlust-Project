<% layout("/layouts/boilerplate") %>

<body class="bg-light">
  <div class="container py-5">
    <div class="col-lg-8 mx-auto">
      <!-- Card Wrapper -->
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-5 bg-white/70 backdrop-blur-md">
          
          <!-- Title -->
          <h3 class="fs-2 fw-bold text-center mb-4 text-primary">
            Create New Listing
          </h3>
          <p class="text-muted text-center mb-5">Fill in the details to add your property</p>

          <!-- Form -->
          <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">

            <!-- Title -->
            <div class="mb-4">
              <label for="title" class="form-label fw-semibold">Title</label>
              <input type="text" name="listing[title]" placeholder="Enter title" 
                     class="form-control form-control-lg rounded-3" required>
            </div>

            <!-- Description -->
            <div class="mb-4">
              <label for="description" class="form-label fw-semibold">Description</label>
              <textarea name="listing[description]" rows="4" 
                        placeholder="Describe your property..."
                        class="form-control rounded-3" required></textarea>
            </div>

            <!-- Image -->
            <div class="mb-4">
              <label for="image" class="form-label fw-semibold">Upload Images <small class="text-muted">(min 5)</small></label>
              <input type="file" name="listing[image]" class="form-control" multiple>
            </div>

            <!-- Price -->
            <div class="mb-4">
              <label for="price" class="form-label fw-semibold">Price</label>
              <div class="input-group">
                <span class="input-group-text">₹</span>
                <input type="text" name="listing[price]" placeholder="Enter price" 
                       class="form-control" required>
              </div>
            </div>

            <!-- Country & Location (Row) -->
            <div class="row g-3 mb-4">
              <div class="col-md-6">
                <label for="country" class="form-label fw-semibold">Country</label>
                <input type="text" name="listing[country]" placeholder="Country" 
                       class="form-control" required>
              </div>
              <div class="col-md-6">
                <label for="location" class="form-label fw-semibold">Location</label>
                <input type="text" name="listing[location]" placeholder="Location" 
                       class="form-control" required>
              </div>
            </div>

            <!-- Property Type -->
            <div class="mb-5">
              <h5 class="fw-bold mb-3">Property Type</h5>
              <div class="row g-3">
                <div class="col-6 col-md-3">
                  <label class="d-flex align-items-center gap-2 border rounded-3 p-3 bg-light hover-shadow-sm w-100">
                    <input type="checkbox" name="listing[property_types][]" value="House" class="form-check-input" />
                    <i data-lucide="home"></i> House
                  </label>
                </div>
                <div class="col-6 col-md-3">
                  <label class="d-flex align-items-center gap-2 border rounded-3 p-3 bg-light hover-shadow-sm w-100">
                    <input type="checkbox" name="listing[property_types][]" value="Boat" class="form-check-input" />
                    <i data-lucide="ship"></i> Boat
                  </label>
                </div>
                <div class="col-6 col-md-3">
                  <label class="d-flex align-items-center gap-2 border rounded-3 p-3 bg-light hover-shadow-sm w-100">
                    <input type="checkbox" name="listing[property_types][]" value="Cabin" class="form-check-input" />
                    <i data-lucide="tent"></i> Cabin
                  </label>
                </div>
                <div class="col-6 col-md-3">
                  <label class="d-flex align-items-center gap-2 border rounded-3 p-3 bg-light hover-shadow-sm w-100">
                    <input type="checkbox" name="listing[property_types][]" value="Castle" class="form-check-input" />
                    <i data-lucide="castle"></i> Castle
                  </label>
                </div>
              </div>
            </div>

            <!-- Basics Section -->
            <div class="mb-5">
              <h5 class="fw-bold mb-3">Share Some Basics</h5>

              <!-- Counter Inputs -->
              <% const basics = ["guests","bedrooms","beds","bathrooms"]; %>
              <% basics.forEach(field => { %>
              <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                <label class="mb-0 text-capitalize fw-semibold"><%= field %></label>
                <div class="d-flex align-items-center gap-2">
                  <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle"
                          onclick="updateCount('<%= field %>', -1)">−</button>
                  <input type="text" name="listing[<%= field %>]" id="<%= field %>" 
                         value="1" class="form-control text-center fw-bold" style="width: 60px;" readonly>
                  <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle"
                          onclick="updateCount('<%= field %>', 1)">+</button>
                </div>
              </div>
              <% }) %>
            </div>

            <!-- Amenities Section -->
            <div class="mb-5">
              <h5 class="fw-bold mb-3">Amenities</h5>
              <p class="text-muted small">Highlight what makes your place special</p>

              <div class="row g-3">
                <% const guestFaves=[ { name: 'Wifi' , icon: 'wifi' }, { name: 'TV' , icon: 'tv' },
                  { name: 'Kitchen' , icon: 'fridge' }, { name: 'Washing machine' , icon: 'smartphone' },
                  { name: 'Free parking on premises' , icon: 'car' }, { name: 'Air conditioning' , icon: 'fan' } ]; %>

                <% guestFaves.forEach(({name, icon})=> { %>
                  <div class="col-6 col-md-4">
                    <label class="d-flex align-items-center gap-2 border rounded-3 p-3 bg-light hover-shadow-sm w-100">
                      <input type="checkbox" name="listing[amenities][]" value="<%= name %>" class="form-check-input" />
                      <i data-lucide="<%= icon %>"></i> <%= name %>
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Submit -->
            <div class="text-center">
              <button class="btn btn-primary btn-lg px-5 rounded-3 shadow">
                Add Listing
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    lucide.createIcons();

    function updateCount(field, delta) {
      const input = document.getElementById(field);
      let value = parseInt(input.value) || 0;
      value = Math.max(0, value + delta); // Prevent negative
      input.value = value;
    }
  </script>
</body>
