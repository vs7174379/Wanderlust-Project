<% layout("/layouts/boilerplate") %>

    <!-- Main Content -->
    <main class="flex flex-col lg:flex-row justify-evenly max-w-6xl h-screen px-6 py-24 ">

        <!-- Left Section -->
        <div class="lg:w-1/2 mb-20 lg:mb-10">
            <h1 class="text-4xl lg:text-5xl font-bold leading-tight">It’s easy to get<br>started on<br>Airbnb</h1>
        </div>

        <!-- Right Section -->
        <div class="lg:w-1/2 space-y-5">
            <!-- Step 1 -->
            <div class="flex items-start justify-between border-b pb-6">
                <div>
                    <h2 class="text-md font-semibold">1 <span class="ml-2">Tell us about your place</span></h2>
                    <p class="text-sm mt-1 text-gray-600">Share some basic info, such as where it is and how many guests
                        can stay.</p>
                </div>
                <img src="https://m.media-amazon.com/images/I/81lyZwtD8yL._UF894,1000_QL80_.jpg" alt="Bed"
                    class="w-20 h-20 object-contain">
            </div>

            <!-- Step 2 -->
            <div class="flex items-start justify-between border-b pb-6">
                <div>
                    <h2 class="text-md font-semibold">2 <span class="ml-2">Make it stand out</span></h2>
                    <p class="text-sm mt-1 text-gray-600">Add 5 or more photos plus a title and description – we’ll help
                        you out.</p>
                </div>
                <img src="https://m.media-amazon.com/images/I/818xVwc3sKL._UF1000,1000_QL80_.jpg" alt="Decor"
                    class="w-20 h-20 object-contain">
            </div>

            <!-- Step 3 -->
            <div class="flex items-start justify-between">
                <div>
                    <h2 class="text-md font-semibold">3 <span class="ml-2">Finish up and publish</span></h2>
                    <p class="text-sm mt-1 text-gray-600">Choose a starting price, verify a few details, then publish
                        your listing.</p>
                </div>
                <img src="https://ik.imagekit.io/durian1985/durian/durian_in/defaultskins/boost79/images/doors/03_Elements-mb-b.jpg"
                    alt="Door" class="w-20 h-20 object-contain">
            </div>
            <a href="/listings/hosting/form">
                <button
                    class="bg-gradient-to-r from-rose-500 to-pink-600 text-white font-semibold px-6 py-2 rounded-lg hover:opacity-90">
                    Get started
                </button>
            </a>
        </div>


    </main>