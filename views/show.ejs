<% layout("/layouts/boilerplate") %>

  <div class="container my-5">
    <div class="row g-4">

      <!-- LEFT COLUMN: Listing Details -->
      <div class="col-md-10">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden p-3">
          <h1 class="fw-bold fs-3 mb-1 d-flex align-items-center justify-content-between"></h1>

          <!-- Featured Image -->
          <div class="mb-3 position-relative">
            <img id="mainImage" src="<%= listing.image[0].url %>" class="img-fluid rounded-4 shadow"
              style="width: 100%; height: 450px; object-fit: cover; transition: transform 0.3s;" alt="Featured Image"
              onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
            <span class="badge bg-dark position-absolute top-0 end-0 m-3 px-3 py-2 shadow">
              ₹ <%= listing.price %> / night
            </span>
          </div>

          <!-- Thumbnails -->
          <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
            <span class="d-flex flex-nowrap gap-2 mb-4 overflow-x-auto no-scrollbar">
              <% listing.image.forEach((img, idx)=> { %>
                <img src="<%= img.url %>" class="img-thumbnail rounded shadow-sm"
                  style="width: 110px; height: 70px; object-fit: cover; cursor: pointer; transition: all .2s;"
                  onclick="document.getElementById('mainImage').src='<%= img.url %>'"
                  onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                <% }) %>

            </span>

            <button class="btn btn-outline-dark fw-bold m-1 h-14 btn-sm" data-bs-toggle="modal"
              data-bs-target="#imageModal">
              Show all photos
            </button>
          </div>

          <!-- Listing Details -->
          <h1 class="fw-bold fs-3 mb-1 d-flex align-items-center justify-content-between">
            <%= listing.title %>
              <!-- Owner Actions -->
              <% if (currUser && currUser._id.toString()===listing.owner._id.toString()) { %>
                <div class="d-flex align-items-center mt-4 justify-content-center gap-3">

                  <!-- Edit Button -->
                  <a href="/listings/<%= listing.id %>/edit"
                    class="btn btn-outline-primary d-flex align-items-center gap-2 px-4 shadow-sm rounded-pill">
                    <i class="bi bi-pencil-square"></i> Edit
                  </a>

                  <!-- Delete Button -->
                  <form method="post" action="/listings/<%= listing.id %>?_method=DELETE"
                    onsubmit="return confirm('⚠️ Are you sure you want to delete this listing?');">
                    <button class="btn btn-outline-danger d-flex align-items-center gap-2 px-4 shadow-sm rounded-pill">
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>

                </div>
                <% } %>

          </h1>
          <p class="text-muted mb-1">
            <%= listing.guests %> guests · <%= listing.bedrooms %> bedrooms · <%= listing.beds %> beds · <%=
                    listing.bathrooms %> bathrooms
          </p>
          <p><strong>⭐ 5.0</strong> · <a href="#" class="text-decoration-none">14 reviews</a></p>
          <hr>

          <!-- Host Info -->
          <div class="d-flex align-items-center mb-3">
            <img src="https://lk-aps.bmscdn.com/Artist/allu-arjun-3736-07-12-2021-01-39-49.jpg"
              class="rounded-circle border border-3 shadow-sm me-3"
              style="width: 60px; height: 60px; object-fit: cover;">
            <div>
              <h6 class="fw-bold mb-0">Hosted by <%= listing.owner.username %>
              </h6>
              <small class="text-muted">Superhost · 4 months hosting</small>
            </div>
          </div>
          <hr>

          <!-- Description -->
          <p class="fw-semibold text-muted lh-lg">
            <%= listing.description %>
          </p>
          <hr>

          <!-- Amenities -->
          <h5 class="fw-bold mb-3">What this place offers</h5>
          <div class="row row-cols-2 row-cols-md-3 g-3">
            <div class="col">
              <div class="p-2 border rounded text-center shadow-sm"><i class="bi bi-wifi fs-5"></i>
                <p>Wifi</p>
              </div>
            </div>
            <div class="col">
              <div class="p-2 border rounded text-center shadow-sm"><i class="bi bi-tv fs-5"></i>
                <p>TV</p>
              </div>
            </div>
            <div class="col">
              <div class="p-2 border rounded text-center shadow-sm"><i class="bi bi-snow fs-5"></i>
                <p>AC</p>
              </div>
            </div>
            <div class="col">
              <div class="p-2 border rounded text-center shadow-sm"><i class="bi bi-microwave fs-5"></i>
                <p>Microwave</p>
              </div>
            </div>
            <div class="col">
              <div class="p-2 border rounded text-center shadow-sm"><i class="bi bi-camera-video fs-5"></i>
                <p>Cameras</p>
              </div>
            </div>
            <div class="col">
              <div class="p-2 border rounded text-center shadow-sm"><i class="bi bi-paw fs-5"></i>
                <p>Pets</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Fullscreen Modal for Review Form -->
         <% if (currUser) { %>

        <div id="reviewModal" class="fixed-top align-items-center modal-overlay bg-black/30 " style="display: none;">
          <div class="modal-content  bg-white/30 backdrop-blur-md border border-white/20 rounded-lg shadow-lg">
            <button class="modal-close" id="closeReviewModal">&times;</button>

            <% if (currUser) { %>
              <h4 class="text-lg font-semibold mb-4">Leave a Review</h4>

              <form action="/listings/<%= listing.id %>/reviews" method="post" class="space-y-4">

                <!-- Rating -->
                <div class="mb-3 mt-3">
                  <label for="rating" class="form-label">Rating</label>
                  <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="Review[rating]" value="1" checked
                      aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="Review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="Review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="Review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="Review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="Review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>

                <!-- Comment -->
                <div>
                  <label for="comment" class="block font-medium mb-2 text-sm text-gray-700">Comment</label>
                  <textarea name="Review[comment]" id="comment" rows="3"
                    class="w-full border border-gray-300 rounded-md p-3 focus:outline-none focus:ring-2 focus:ring-blue-400"
                    placeholder="Describe your experience..." required></textarea>
                  <p class="text-sm text-gray-400 mt-1">Please write your feedback (required).</p>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                  <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded shadow">
                    Submit
                  </button>
                </div>

              </form>
              <% } %>
          </div>
        </div>
        <% } %>



      </div>

      <!-- RIGHT COLUMN: Sticky Payment Card -->


      <div class="col-md-2">
        <div class="card shadow-lg border-0 rounded-4 p-4 position-sticky bg-white" style="top: 100px;">

          <!-- Price -->
          <h3 class="fw-bold mb-3 d-flex align-items-center">
            <span class="text-dark">₹ <%= listing.price %></span>
            <small class="text-muted ms-2">/ night</small>
          </h3>

          <!-- Booking Form -->
          <form id="bookingForm" class="needs-validation" novalidate>
            <!-- Dates -->
            <div class="mb-3">
              <label class="form-label fw-semibold small">Select Dates</label>
              <input type="text" id="dateRange" class="form-control rounded-3 shadow-sm border-0 bg-light"
                placeholder="Check-in → Check-out">
            </div>

            <!-- Guests -->
            <div class="mb-3">
              <label class="form-label fw-semibold small">Guests</label>
              <select class="form-select rounded-3 shadow-sm border-0 bg-light">
                <option>1 guest</option>
                <option>2 guests</option>
                <option>3 guests</option>
                <option>4 guests</option>
                <option>5+ guests</option>
              </select>
            </div>

            <!-- Reserve Button -->
            <button id="payBtn" type="submit"
              class="btn btn-dark w-100 rounded-3 fw-bold py-2 shadow-sm transition-transform hover-scale">
              Reserve Now
            </button>

            <!-- Secure Note -->
            <div class="text-center mt-2 small text-muted">
              <i class="bi bi-shield-check me-1 text-success"></i>
              Secure Booking – No hidden fees
            </div>
          </form>

          <!-- Divider -->
          <hr class="my-4">

          <!-- Price Breakdown -->
          <div id="priceDetails">
            <div class="mb-2 d-flex justify-content-between text-muted small">
              <span>₹ <%= listing.price %> × 1 night</span>
              <span>₹ <%= listing.price %></span>
            </div>
            <div class="mb-3 d-flex justify-content-between text-muted small">
              <span>Service Fee</span>
              <span>₹ 200</span>
            </div>
          </div>

          <!-- Total -->
          <div class="d-flex justify-content-between fw-bold fs-5">
            <span>Total</span>
            <span id="totalPrice" class="text-dark">₹ <%= listing.price + 200 %></span>
          </div>
        </div>
      </div>


      <style>
        .hover-scale:hover {
          transform: scale(1.02);
          background-color: #111 !important;
        }

        .form-control:focus,
        .form-select:focus {
          box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, .25);
        }
      </style>

    </div>


    <!-- Modal: All Images -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-xl">
        <div class="modal-content rounded-4">
          <div class="modal-header">
            <h5 class="modal-title">All Photos</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="row g-2">
              <% listing.image.forEach((img)=> { %>
                <div class="col-6 col-md-4">
                  <img src="<%= img.url %>" class="img-fluid rounded shadow-sm mb-2" alt="img" />
                  <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
                    <form method="POST" action="/listings/<%= listing.id %>/image/<%= img._id %>?_method=DELETE">
                      <button type="submit" class="btn btn-sm btn-danger w-100">Delete</button>
                    </form>
                    <% } %>
                </div>
                <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Reviews -->

    <hr>
    <!-- Write Comment Button -->
     <% if (currUser) { %>
    <div class="col-12 m-4">
      <button class="btn btn-outline-dark" type="button" id="openReviewModal">
        Write Comment
      </button>
    </div>
    <% } %>
    <% if (listing.reviews.length> 0) { %>
      <hr class="my-4 ">
      <h4 class="fw-bold mb-3">What guests are saying</h4>

      <div class="row g-3">
        <% for (review of listing.reviews) { %>
          <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
              <div class="card-body p-4 d-flex flex-column justify-content-between">

                <!-- User Info -->
                <div class="d-flex align-items-center mb-3">
                  <div
                    class="bg-dark text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm"
                    style="width: 44px; height: 44px; font-weight: 600; font-size: 1.1rem;">
                    <%= review.author.username[0].toUpperCase() %>
                  </div>
                  <div class="ms-3">
                    <h6 class="mb-0 fw-semibold">
                      <%= review.author.username %>
                    </h6>
                    <small class="text-muted">3 months on Airbnb</small>
                  </div>
                </div>

                <!-- Rating + Date -->
                <div class="d-flex align-items-center mb-2">
                  <div class="me-2">
                    <% for (let i=1; i <=5; i++) { %>
                      <% if (i <=review.rating) { %>
                        ⭐
                        <% } else { %>
                          ☆
                          <% } %>
                            <% } %>
                  </div>
                  <small class="text-muted ms-2">· April 2025</small>
                </div>

                <!-- Review Text -->
                <p class="mb-3 text-muted" style="font-size: 0.95rem; line-height: 1.5;">
                  <%= review.comment.length> 200 ? review.comment.substring(0,200) + "..." : review.comment %>
                </p>

                <!-- Actions -->
                <div class="d-flex justify-content-between align-items-center">
                  <% if (review.comment.length> 200) { %>
                    <a href="#" class="fw-semibold text-dark text-decoration-none small">Show more</a>
                    <% } %>

                      <% if (currUser && currUser._id.equals(review.author._id)) { %>
                        <form method="POST"
                          action="/listings/<%= listing.id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                          <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                        <% } %>
                </div>

              </div>
            </div>
          </div>
          <% } %>
      </div>
      <% } else { %>
        <p class="text-muted">No reviews yet. Be the first to leave one!</p>
        <% } %>
  </div>




  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    let total = '<%= listing.price + 200 %>'; // default (1 night + service fee)
    let checkIn = null;
    let checkOut = null;
    const pricePerNight = '<%= listing.price %>';
    const serviceFee = 200;
    const totalPriceEl = document.getElementById("totalPrice");
    const priceDetails = document.getElementById("priceDetails");
    const bookedDates =<%- JSON.stringify(
      bookedDates.map(date => ({
        from: date.start,   
        to: date.end        
      }))
    )%> // booked dates from backend

    // update `total` when user picks dates
    flatpickr("#dateRange", {
      mode: "range",
      minDate: "today",
      dateFormat: "Y-m-d",
      disable:bookedDates, // disable booked dates
      defaultDate: null,
      onChange: function (selectedDates) {
        if (selectedDates.length === 2) {
          checkIn = selectedDates[0];
          checkOut = selectedDates[1];


          const diffTime = checkOut - checkIn;
          const nights = diffTime / (1000 * 60 * 60 * 24);

          const stayCost = pricePerNight * nights;
          total = stayCost + serviceFee;

          // Update breakdown
          priceDetails.innerHTML = `
          <div class="mb-2 d-flex justify-content-between text-muted small">
            <span>₹ ${pricePerNight} × ${nights} night${nights > 1 ? "s" : ""}</span>
            <span>₹ ${stayCost}</span>
          </div>
          <div class="mb-3 d-flex justify-content-between text-muted small">
            <span>Service Fee</span>
            <span>₹ ${serviceFee}</span>
          </div>
        `;

          // Update total
          totalPriceEl.textContent = "₹ " + total;
        }
      }
    });

    document.getElementById("payBtn").onclick = async function (e) {
      e.preventDefault();
      if (!checkIn || !checkOut) {
        alert("Please select check-in and check-out dates.");
        return;
      }

      if (!total || total <= 0) {
        alert("Please select check-in and check-out dates.");
        return;
      }

      // 1️⃣ Create order with calculated total
      const response = await fetch("http://localhost:8080/listings/<%= listing._id %>/payment/order", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          amount: total * 100,
          checkIn, checkOut
        }) // ✅ send dynamic total in paise
      });

      const order = await response.json();
      console.log("Order created:", order);

      // 2️⃣ Razorpay Checkout
      const options = {
        key: "rzp_test_CY6Vuttr0BdTnS",
        amount: order.amount,
        currency: "INR",
        name: "StayBook",
        description: "Booking Payment",
        order_id: order.id,
        handler: async function (response) {
          // 3️⃣ Verify on backend
          const verifyRes = await fetch("http://localhost:8080/listings/<%=listing.id%>/payment/verify", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              listingId: "<%=listing.id%>",
              userId: "<%=currUser ? currUser._id : ''%>",
              amount: order.amount,
              checkIn, checkOut
            })
          });

          const verifyData = await verifyRes.json();
          if (verifyData.success) {
            alert("✅ Payment Successful! Booking confirmed.");
            window.location.href = "/listings/<%=listing.id%>/payment/order/bookings";
          } else {
            alert("❌ Payment verification failed.");
          }
        }
      };

      const rzp1 = new Razorpay(options);
      rzp1.open();
    };

    // Review Modal Logic
    const reviewModal = document.getElementById("reviewModal");
    const openReviewModalBtn = document.getElementById("openReviewModal");
    const closeReviewModalBtn = document.getElementById("closeReviewModal");
    openReviewModalBtn.onclick = function () {
      reviewModal.style.display = "block";
    };
    closeReviewModalBtn.onclick = function () {
      reviewModal.style.display = "none";
    };
    window.onclick = function (event) {
      if (event.target == reviewModal) {
        reviewModal.style.display = "none";
      }
    };



  </script>